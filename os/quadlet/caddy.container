[Unit]
Description=pithead caddy
[Container]
ContainerName=caddy
Image=docker.io/library/caddy:2.11.9@sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b
Network=host
Environment="DASHBOARD_PROXY_SECRET=rendered-proxy-secret"
Volume=/opt/pithead/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=pithead-caddy-data:/data
Volume=/opt/pithead/data/caddy-logs:/var/log/caddy
Tmpfs=/tmp
Tmpfs=/config
ReadOnly=true
DropCapability=all
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
PodmanArgs=--memory 128m --memory-swap 128m
[Service]
Restart=always
[Install]
WantedBy=multi-user.target
