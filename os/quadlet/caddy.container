[Unit]
Description=pithead caddy
[Container]
ContainerName=caddy
Image=docker.io/library/caddy:2.11.7@sha256:f2a1290d0463aad60660d4ec134943f183ee2a5f6c3eb7bf32dd984f2f020772
Network=host
Volume=/opt/pithead/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=pithead-caddy-data:/data
Volume=/opt/pithead/data/caddy-logs:/var/log/caddy
Tmpfs=/tmp
Tmpfs=/config
ReadOnly=true
DropCapability=all
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
PodmanArgs=--memory 128m --memory-swap 128m
[Service]
Restart=always
[Install]
WantedBy=multi-user.target
