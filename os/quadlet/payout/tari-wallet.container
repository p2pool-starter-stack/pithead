[Unit]
Description=pithead tari-wallet
After=tari.service
Requires=tari.service
[Container]
ContainerName=tari-wallet
Image=ghcr.io/tari-project/minotari_console_wallet:v6.0.1-pre.0-mainnet@sha256:6f1f7d8990d304466f70a0379dcef4825c29b785c10d7fc7dff4d89163ed1b9d
Network=mining.network
IP=172.28.0.31
User=0:0
Entrypoint=/wallet-config/entrypoint.sh
Environment="TARI_WALLET_ADDRESS=your_tari_wallet_address" "TARI_BASE_NODE_GRPC_ADDRESS=172.28.0.27:18142" "TARI_WALLET_BIRTHDAY=auto" "PAYOUT_SCAN_GRACE_SEC=" TARI_WALLET_GRPC_BIND=/ip4/0.0.0.0/tcp/18143 WALLET_DIR=/var/tari/wallet
Volume=pithead-tari-wallet-db:/var/tari/wallet
Volume=/home/pithead/build/tari-wallet:/wallet-config:ro
Volume=/opt/pithead/data/tari-wallet-secret.env:/run/secrets/tari_wallet_secret:ro
Tmpfs=/tmp:size=32m,mode=1777
PublishPort=127.0.0.1:18143:18143
ReadOnly=true
DropCapability=all
AddCapability=CHOWN DAC_OVERRIDE SETUID SETGID
NoNewPrivileges=true
RunInit=true
# tari#8063: pinned gRPC wallet does not shut down on SIGTERM or SIGINT.
# The appliance test checks the persisted SQLite reopen after a forced stop.
StopTimeout=10
PodmanArgs=--memory 512m --memory-swap 512m
HealthCmd=/wallet-config/wallet-healthcheck.sh
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=120s
Notify=healthy
[Service]
Restart=always
TimeoutStartSec=infinity
[Install]
WantedBy=multi-user.target
