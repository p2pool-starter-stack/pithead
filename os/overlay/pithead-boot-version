#!/bin/bash
# Keep the version stored for each A/B slot beside RAUC's boot state in grubenv.
set -uo pipefail

GRUBENV=${PITHEAD_GRUBENV:-/boot/efi/grub/grubenv}
CMDLINE=${PITHEAD_CMDLINE:-/proc/cmdline}
VERSION_FILE=${PITHEAD_VERSION_FILE:-/opt/pithead/VERSION}

valid_version() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; }
booted_slot() { tr ' ' '\n' <"$CMDLINE" 2>/dev/null | sed -n 's/^rauc\.slot=\([AB]\)$/\1/p'; }
grub_value() { grub-editenv "$GRUBENV" list 2>/dev/null | sed -n "s/^$1=//p" | head -1; }
write_slot_version() { # <A|B> <version-or-empty>
    case "$1" in A | B) ;; *) return 1 ;; esac
    [ -z "$2" ] || valid_version "$2" || return 1
    grub-editenv "$GRUBENV" set "$1_VERSION=$2"
}

record_media() {
    local esp disk tran media=internal
    esp=$(findmnt -no SOURCE /boot/efi 2>/dev/null) || return 1
    [ -n "$esp" ] || return 1
    disk=$(lsblk -no PKNAME "$esp" 2>/dev/null) || return 1
    [ -n "$disk" ] || return 1
    tran=$(lsblk -dno TRAN "/dev/$disk" 2>/dev/null) || tran=""
    [ "$tran" = usb ] && media=usb
    [ "$(grub_value MEDIA)" = "$media" ] && return 0
    grub-editenv "$GRUBENV" set "MEDIA=$media"
}

menu_version() { # <VERSION-file>; BUILD_LABEL is display-only and belongs to that slot
    local file="${1:-$VERSION_FILE}" version label=""
    version=$(tr -d '[:space:]' <"$file") || return 1
    valid_version "$version" || return 1
    if [ -f "${file%/*}/BUILD_LABEL" ]; then
        # Read at most 18 bytes: a 16-byte token plus one newline fits. A NUL or
        # an overlong file makes read succeed and is rejected; EOF preserves all bytes.
        if LC_ALL=C IFS= read -r -n 18 -d '' label <"${file%/*}/BUILD_LABEL" 2>/dev/null; then
            label=""
        else
            label=${label%$'\n'}
        fi
        [[ "$label" =~ ^[A-Za-z0-9.-]{1,16}$ ]] && version="$version+$label"
    fi
    printf '%s\n' "$version"
}

record_booted() {
    local slot version
    slot=$(booted_slot)
    version=$(menu_version "$VERSION_FILE") || return 1
    [ -n "$slot" ] && valid_version "$version" || return 1
    write_slot_version "$slot" "$version"
}

record_installed() { # <bundle-version>; RAUC has already put the target first in ORDER
    local version="$1" running target order
    valid_version "$version" || return 1
    running=$(booted_slot)
    order=$(grub_value ORDER)
    order=${order#\"}
    order=${order%\"}
    target=${order%% *}
    [ -n "$running" ] && [ "$target" != "$running" ] || return 1
    write_slot_version "$target" "$version"
}

[ "${BASH_SOURCE[0]}" = "$0" ] || return 0
case "${1:-}" in
# Never fails the unit. This ran inside pithead-boot with `|| echo`, and a boot-menu label is not
# worth a red unit on a machine that is otherwise fine — an image built with no updater has no
# `rauc.slot=` to read, and the next update or boot repairs a write that could not land. The
# journal still says so, and the battery asserts `systemctl --failed` is empty (#792).
record-booted)
    record_media || echo "pithead-boot-version: could not refresh the media label" >&2
    record_booted || echo "pithead-boot-version: could not refresh the booted slot's version label" >&2
    ;;
menu-version) menu_version "${2:-$VERSION_FILE}" ;;
record-installed) record_installed "${2:-}" ;;
*)
    echo "usage: pithead-boot-version record-booted | record-installed VERSION | menu-version [VERSION_FILE]" >&2
    exit 2
    ;;
esac
