#!/bin/bash
set -u
cd "${PITHEAD_DIR:-/data/pithead}" 2>/dev/null || exit 0
STATE="${PITHEAD_ADDRESS_WATCH_STATE:-/run/pithead-address-watch}"
TLS_DIR="${PITHEAD_TLS_DIR:-data/tls}"
BOOT_UNIT="${PITHEAD_BOOT_UNIT:-pithead-boot.service}"
LOCK="${PITHEAD_LOCK_FILE:-.pithead.lock}"

[ -x ./pithead ] && [ -s .env ] && [ -s config.json ] || exit 0
[ "$(systemctl is-active "$BOOT_UNIT" 2>/dev/null)" != activating ] || exit 0

addrs=$(hostname -I 2>/dev/null | tr ' ' '\n' | sed '/^$/d' | sort | tr '\n' ' ')
[ -n "$addrs" ] || exit 0

sig() { sha256sum "$TLS_DIR/wizard.crt" Caddyfile 2>/dev/null | cut -d' ' -f1 | tr '\n' ' '; }

if [ -f "$STATE" ] && [ "$addrs" = "$(cat "$STATE")" ]; then
    now=$(sig)
    if [ -f "$STATE.served" ]; then
        if [ "$now" != "$(cat "$STATE.served")" ]; then
            printf '%s' "$now" >"$STATE.served"
            echo "pithead-address-watch: the dashboard certificate or the Caddyfile changed while the addresses held — the operation that re-rendered them owns the Caddy restart; recorded, not restarted here"
        fi
    else
        printf '%s' "$now" >"$STATE.served"
    fi
    exit 0
fi

served=$(cat "$STATE.served" 2>/dev/null)
[ -n "$served" ] || { served=$(sig); printf '%s' "$served" >"$STATE.served"; }

exec 9>>"$LOCK" || exit 0
if ! flock -n 9; then
    echo "pithead-address-watch: another pithead operation holds the lock; retrying on the next tick"
    exit 0
fi
if PITHEAD_LOCK_HELD=$$ ./pithead render >/dev/null 2>&1; then
    printf '%s' "$addrs" >"$STATE"
else
    echo "pithead-address-watch: render failed; retrying on the next tick"
fi
now=$(sig)
if [ "$now" != "$served" ]; then
    echo "pithead-address-watch: the machine's addresses changed — re-rendered the dashboard certificate and Caddyfile, restarting Caddy"
    if ${PITHEAD_CADDY_RESTART_CMD:-docker compose restart caddy} >/dev/null 2>&1; then
        printf '%s' "$now" >"$STATE.served"
    else
        echo "pithead-address-watch: Caddy did not restart; retrying on the next tick"
    fi
fi
exit 0
