# shellcheck shell=bash
# pithead-boot's stack-health signal (#2383), split from pithead-boot at its file-budget ceiling,
# and the URL helpers gate_url builds the dashboard probe with (#1140), split the same way.
# `status` prints credentials and the remote-access address, so its transient record is 0600.
BOOT_STATUS_LOG=/run/pithead-boot-status.log
boot_status_blocking() { # unhealthy/restarting rows as "container NAME: reason" (sync-held #31/#35 excluded)
    [ -s "$BOOT_STATUS_LOG" ] || return 0
    grep -E '(✗|⚠.*UNHEALTHY)' "$BOOT_STATUS_LOG" 2>/dev/null |
        sed -E 's/^[[:space:]]*[✗⚠][[:space:]]+([^[:space:]]+)[[:space:]]+/container \1: /'
}
boot_status() {
    install -m 600 /dev/null "$BOOT_STATUS_LOG" || return 1
    PITHEAD_BOOT_GATE=1 ./pithead status >"$BOOT_STATUS_LOG" 2>&1
}
boot_status_ready() { boot_status && ! grep -q 'health check pending' "$BOOT_STATUS_LOG"; }

# Did that answer come from the DASHBOARD, or from Caddy answering for a Host it has no site for?
# The default vhost's reply is 200 with a zero-length body. Everything the dashboard vhost produces
# is either the 401 its login sends or a real page, so require one of those — `!= 000` cannot tell
# them apart, and that is what let the wrong Host read as success. Belt and braces with gate_url:
# if the site list and this probe ever disagree again, the gate FAILS instead of lying.
gate_answer_is_dashboard() { # <http_code> <size_download>
    [ -n "${1:-}" ] && [ "${1}" != "000" ] || return 1
    [ "$1" = "401" ] || [ "${2:-0}" -gt 0 ]
}

# ALL THREE signals, paired in one place (#852, #2383) so a grep-only assertion cannot go stale.
gate_ready() { # <http_code> <size_download>
    gate_answer_is_dashboard "$1" "$2" || return 1
    # shellcheck disable=SC2034 # read by pithead-boot's sourced main loop
    gate_doctor_ran=1
    PITHEAD_BOOT_GATE=1 ./pithead doctor --json >"$BOOT_DOCTOR_JSON" 2>/dev/null || return 1
    boot_status_ready
}

gate_cert_advisory_ready() { gate_cert_advisory && boot_status_ready; }

# dashboard.host is validated as "a hostname or IP address — letters, digits, dots, hyphens, and
# colons", so HOST_IP can be an IPv6 literal, and these two exist because of what curl does with one:
#   - a URL needs it bracketed, or the port reads as part of the address;
#   - `--resolve` cannot take one at all — curl rejects the whole option with "Couldn't parse
#     CURLOPT_RESOLVE entry", which fails the request, which on this gate means a healthy box never
#     commits and #1065 reboots it. Measured against curl 8.7, bracketed and unbracketed alike.
# A literal needs no resolution anyway: the box owns the address. So --resolve is for NAMES, where
# it is what keeps the dial on loopback instead of depending on the machine resolving its own mDNS
# name — the one lookup a boot-time health probe must not be hostage to.
gate_target_url() { # <scheme> <host> <port>
    case "$2" in
    *:*) printf '%s://[%s]:%s/.pithead-boot-health' "$1" "$2" "$3" ;;
    *) printf '%s://%s:%s/.pithead-boot-health' "$1" "$2" "$3" ;;
    esac
}
gate_resolve_spec() { # <host> <port> -> a --resolve spec, or empty when the host needs no lookup
    case "$1" in
    *:*) ;;                                          # IPv6 literal
    *[!0-9.]*) printf '%s:%s:127.0.0.1' "$1" "$2" ;; # a name
    *) ;;                                            # IPv4 literal
    esac
}

# Same domain-separated digest as Caddy's renderer, using the owner-only .env auth hash.
# Stream the capability to curl's stdin so it never becomes a process argument.
gate_probe_header() {
    local capability
    capability=$(printf 'pithead-boot-health-v1:%s' "$(gate_env_val DASHBOARD_AUTH_HASH_B64)" | sha256sum | cut -d' ' -f1)
    printf 'X-Pithead-Boot-Probe: %s\n' "$capability"
}

boot_gate_passed() {
    rm -f "$BOOT_FAIL_COUNT" .config-reset-good-slot
    schema_hold_release
}

SCHEMA_HOLD_NAME=.os-schema-held
booted_slot_committed() {
    local slot status
    slot=$(tr ' ' '\n' <"${PITHEAD_CMDLINE:-/proc/cmdline}" 2>/dev/null | sed -n 's/^rauc\.slot=\([AB]\)$/\1/p')
    [ -n "$slot" ] || return 1
    command -v jq >/dev/null 2>&1 || return 1
    status=$(rauc status --output-format=json 2>/dev/null) || return 1
    jq -e --arg slot "$slot" \
        '[.slots[] | .[] | select(.state == "booted" and .bootname == $slot and .boot_status == "good")] | length == 1' \
        <<<"$status" >/dev/null 2>&1
}

schema_hold_arm() {
    local dir
    dir=$(gate_env_val DASHBOARD_DATA_DIR)
    [ -n "$dir" ] || return 0
    if booted_slot_committed; then
        rm -f "$dir/$SCHEMA_HOLD_NAME" && sync
        return 0
    fi
    mkdir -p "$dir" && : >"$dir/$SCHEMA_HOLD_NAME" && sync &&
        echo "pithead-boot: dashboard schema hold armed — the booted slot is uncommitted, so the dashboard keeps its previous-release database schema until the gate commits"
}

schema_hold_release() {
    local dir
    dir=$(gate_env_val DASHBOARD_DATA_DIR)
    [ -n "$dir" ] || return 0
    [ -e "$dir/$SCHEMA_HOLD_NAME" ] || return 0
    rm -f "$dir/$SCHEMA_HOLD_NAME" && sync
    echo "pithead-boot: dashboard schema hold released — restarting the dashboard to run its deferred database migrations"
    ${PITHEAD_DASHBOARD_RESTART_CMD:-docker compose restart dashboard} >/dev/null 2>&1 ||
        echo "pithead-boot: FAULT — the committed slot could not restart the dashboard to run its deferred database migrations; run 'docker compose restart dashboard' from /data/pithead" >&2
}
gate_tor_transport_verdict() {
    BOOT_TOR_VERDICT=down
    local cid info state health
    cid=$(docker compose ps -aq tor 2>/dev/null | head -n 1)
    [ -n "$cid" ] || { printf 'down\n'; return 0; }
    info=$(docker inspect --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null)
    [ -n "$info" ] || { printf 'down\n'; return 0; }
    state=${info%% *}
    health=${info##* }
    if [ "$state" = running ]; then
        case "$health" in
        healthy) BOOT_TOR_VERDICT=up ;;
        starting | unhealthy) BOOT_TOR_VERDICT=wedged ;;
        esac
    fi
    printf '%s\n' "$BOOT_TOR_VERDICT"
}
gate_blocked_only_by_network() {
    GATE_NETWORK_ADVISORY=""
    command -v jq >/dev/null 2>&1 || return 1
    [ -s "${BOOT_DOCTOR_JSON:-}" ] || return 1
    jq -e --arg tor "$1" --arg sat "Tor's circuit-build-time history is saturated" '
        ($tor != "down") as $torup |
        ($tor == "wedged") as $w |
        [.checks[]? | select(.status == "fail") | .message] |
        all(.[];
            test("^(Monero|Tari) node is NOT following the chain")
            or ($torup and test("^" + $sat))
            or ($w and test("^(monerod|tari|wallet-rpc|tari-wallet) is (down|not ready)")))' \
        "$BOOT_DOCTOR_JSON" >/dev/null 2>&1 || return 1
    local line blocked="" bad=0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
        'container monero: chain '* | 'container tari: chain '*) ;;
        'container tor: '* | 'container monerod: '* | 'container tari: '* | 'container wallet-rpc: '* | 'container tari-wallet: '*)
            [ "$1" = wedged ] || bad=1 ;;
        *) bad=1 ;;
        esac
        blocked="${blocked:+$blocked; }$line"
    done <<<"$2"
    [ "$bad" = 0 ] || return 1
    local fails
    fails=$(jq -r '[.checks[]? | select(.status == "fail") | .message] | join("; ")' "$BOOT_DOCTOR_JSON" 2>/dev/null)
    GATE_NETWORK_ADVISORY=$(printf '%s' "${fails:+$fails}${blocked:+${fails:+; }$blocked}" | jq -Rr '.[0:480]')
    [ -n "$GATE_NETWORK_ADVISORY" ]
}
boot_publish_os_update_verdict() {
    [ -f "${OS_INFLIGHT:-}" ] && command -v jq >/dev/null 2>&1 || return 0
    local state_dir
    state_dir="${OS_STATE_DIR:-data/control/results}"
    local to
    to=$(jq -r '.to // ""' "$OS_INFLIGHT" 2>/dev/null)
    if [ -n "$to" ] && [ "$to" = "$(tr -d '[:space:]' <VERSION 2>/dev/null)" ]; then
        mkdir -p "$state_dir" 2>/dev/null || true
        jq -n --arg f "$(jq -r '.from // ""' "$OS_INFLIGHT" 2>/dev/null)" --arg t "$to" --arg a "${1:-}" \
            '{step:"idle",verdict:{outcome:"updated",from:$f,to:$t,ts:(now|floor),advisory:(if $a == "" then [] else [$a] end)}}' \
            >"$state_dir/os-update-state.json" 2>/dev/null || true
        echo "pithead-boot: OS update to $to committed — verdict published to the dashboard"
    fi
    rm -f "$OS_INFLIGHT"
}
gate_network_advisory_commit() {
    local gs gh gp target rs rargs=() code size blocked verdict
    IFS='|' read -r gs gh gp <<<"$(gate_url)"
    target=$(gate_target_url "$gs" "$gh" "$gp")
    rs=$(gate_resolve_spec "$gh" "$gp")
    [ -n "$rs" ] && rargs=(--resolve "$rs")
    read -r code size <<<"$(gate_probe_header | curl --header @- -kso /dev/null -w '%{http_code} %{size_download}' --max-time 5 \
        --noproxy '*' --connect-to '::127.0.0.1:' "${rargs[@]}" "$target" 2>/dev/null)"
    gate_answer_is_dashboard "${code:-000}" "${size:-0}" || return 1
    PITHEAD_BOOT_GATE=1 ./pithead doctor --json >"$BOOT_DOCTOR_JSON" 2>/dev/null || true
    boot_status || true
    blocked=$(boot_status_blocking)
    verdict=$(gate_tor_transport_verdict)
    gate_blocked_only_by_network "$verdict" "$blocked" || return 1
    rauc status mark-good && sync || return 1
    boot_gate_passed
    commit_config_stamp
    echo "pithead-boot: the dashboard answers and every boot check that still fails is this machine's network, not the slot (${GATE_NETWORK_ADVISORY}) — the fault lives on the shared data, so the previous version carries it too and a rollback could not clear it: the booted slot commits with the fault recorded as advisory, and mining stays down until the network recovers"
    boot_publish_os_update_verdict "$GATE_NETWORK_ADVISORY"
    [ "${hold_chain:-0}" != 0 ] || restore_data_floor_after_fallback "${migration_fingerprint:-}" ||
        echo "pithead-boot: FAULT — the previous migration candidate remains protected" >&2
    [ "${hold_chain:-}" = 1 ] && { release_held_chain_services "${migration_fingerprint:-}" || true; }
    return 0
}
