#!/bin/bash
set -eu
umask 077
STATE=${PITHEAD_MINER_RECOVERY_STATE:-/run/pithead-miner-recovery.state}
reset_window() {
    rm -f "$STATE"
    exit 0
}
cd "${PITHEAD_DIR:-/data/pithead}" 2>/dev/null || reset_window
exec 9>>"${PITHEAD_LOCK_FILE:-.pithead.lock}"
flock -n 9 || reset_window
[ "$(cat machine-role 2>/dev/null || true)" != rig ] || reset_window
jq -e '.local_miner.enabled == true' config.json >/dev/null 2>&1 || reset_window
systemctl is-active --quiet xmrig.service || reset_window
worker_config=${PITHEAD_MINER_RECOVERY_CONFIG:-/data/rigforge/data/worker/xmrig/build/config.json}
worker=$(jq -er '.pools[0].user | select(type == "string" and length > 0)' "$worker_config" 2>/dev/null) || reset_window
rig_id=$(jq -er '.pools[0]["rig-id"] // "" | select(type == "string")' "$worker_config" 2>/dev/null) || reset_window
reading=$(
    timeout 15 podman exec -i dashboard python - "$worker" "$rig_id" <<'PY'
import os
from mining_dashboard.helper.http import bounded_get
try:
    token = os.environ.get("PROXY_AUTH_TOKEN", "")
    headers = {"Authorization": "Bearer " + token} if token else {}
    url = "http://{}:{}/1/summary".format(
        os.environ.get("PROXY_HOST", "xmrig-proxy"),
        os.environ.get("PROXY_API_PORT", "3344"))
    response = bounded_get(url, headers=headers, timeout=5)
    response.raise_for_status()
    body = response.json()
    count = body["miners"]["now"]
    if type(count) is not int or count < 0:
        raise ValueError("invalid aggregate miners")
    print("idle" if count == 0 else "reset")
except Exception:
    print("reset")
PY
) 2>/dev/null || reset_window
[ "$reading" = idle ] || reset_window
read -r uptime _ <"${PITHEAD_MINER_RECOVERY_UPTIME:-/proc/uptime}"
now=${uptime%%.*}
start=$(cat "$STATE" 2>/dev/null || true)
case "$start" in '' | *[!0-9]*) start=$now ;; esac
if [ "$start" -gt "$now" ]; then start=$now; fi
printf '%s\n' "$start" >"$STATE"
[ "$((now - start))" -ge 300 ] || exit 0
jq -e '.local_miner.enabled == true' config.json >/dev/null 2>&1 || reset_window
systemctl is-active --quiet xmrig.service || reset_window
printf '%s\n' 'pithead-miner-recovery: active local miner disconnected for 300 seconds; restarting xmrig'
systemctl --no-block try-restart xmrig.service
rm -f "$STATE"
