# --- Tari Base Node Configuration Template ---
# This file is processed by pithead to inject the specific Onion address.

[common]
# Base directory for blockchain database and logs
base_path = "/var/tari/node"

[p2p.seeds]
# DNS seeds are DISABLED for privacy (dns_seeds = [] below), so the node does ZERO seed DNS and
# bootstraps purely from the onion peer_seeds over Tor (#162). The name servers below are now inert,
# kept only for reference. NOTE: despite the ":853/host" form, this was never DNS-over-TLS — with
# dns_seeds_use_dnssec = false the suffix is dropped and Tari queries plaintext UDP/53.
dns_seed_name_servers = [
    "1.1.1.1:853/cloudflare-dns.com",
    "8.8.8.8:853/dns.google",
    "9.9.9.9:853/dns.quad9.net",
]
dns_seeds_use_dnssec = false

[mainnet.p2p.seeds]
# No DNS seeds: a seeds.tari.com TXT lookup leaks a clearnet DNS query from this host's IP (#162).
# Bootstrap from the onion peer_seeds below instead (refresh them periodically as seeds rotate).
dns_seeds = []

# Hardcoded ONION peer seeds (bootstrap over Tor). The clearnet /ip4//ip6/ variants were dropped for
# a strict no-clearnet audit (#162) — onion-only.
# Source of truth: `dig TXT seeds.tari.com`. Last synced 2026-09-22 (minotari_node v6.0.0).
peer_seeds = [
    "1069fb56a3aaba45b9aa9839714251a4dfeb850e8d79d6ac9ca180377120fe1c::/onion3/urvwskrhqa52km46xt2oevblebmylleglph6dythhndmctwdzl6cuoqd:18141",
    "54e491e0d88633170a98898f5d89ccc6b4f7ec22252afc23fe645d5bab453734::/onion3/b5zgqd6emm6p2zmj7gdniysbxvmtvltrwshsyfxjoq26xqfjoicge5id:18141",
    "7c8e6530294e8bb7ff45b0f39e8bf8ea4e461b3df15a2df1ba3fa3a9bcc9ef71::/onion3/5husjyv2zskwjh2wzbuirbq4gk5uiyx4gnn277r3yoxv4oucn72tmeyd:18141",
    "94a4b29148621479b1c1dffb1a2f5680dcf2c0cfb901152e245d6ec299821f61::/onion3/x4cc7t4z5bhzz2qoj5qkfje6jnisz5gvzixeygvzwgi6sg3rhpo5rlqd:18141",
    "94b0e12289ed6a39c898d13048026a0b5ab939bd52544574d61da88f3deb5c70::/onion3/mzf4uhknl3kvwp7wcojew5ozy335mtludwy7hd7kvod5qidsumhieayd:18141",
]

[base_node]
# Enable merge mining capabilities
mining_enabled = true

# No in-process Tor (#2653). The upstream image is built with the `libtor` feature and this defaults
# to true, so under a Tor transport minotari starts its own Tor, which dials Tor relays (ORPort
# 9001) straight from this container instead of going through the stack's `tor` container. The
# SOCKS5 transport below never starts it either; this keeps it off if the transport is ever changed
# back.
use_libtor = false

# gRPC Interface Configuration
grpc_enabled = true
grpc_address = "/ip4/0.0.0.0/tcp/18142"

# Allowed gRPC methods (#91): pruned to the node-status + merge-mining surface our two consumers
# actually call. The dashboard's Tari client (tari_client.py) uses get_tip_info + get_sync_progress
# (with get_version/get_sync_info as fallbacks); p2pool's merge-mining needs the block-template,
# submit_block and tip methods. Everything else — the wallet/transaction, UTXO/kernel/payment-ref
# search, mempool-tx and DAN validator-node calls — has no consumer here, so it's removed (smaller
# attack surface on the gRPC port). Re-add a method if a future dashboard panel needs it.
grpc_server_allow_methods = [
    "get_version",
    "get_sync_info",
    "get_sync_progress",
    "get_tip_info",
    "identify",
    "get_network_status",
    "list_headers",
    "get_header_by_hash",
    "get_blocks",
    "get_block_timing",
    "get_constants",
    "get_block_size",
    "get_block_fees",
    "get_network_difficulty",
    "get_new_block_template",
    "get_new_block",
    "get_new_block_with_coinbases",
    "get_new_block_template_with_coinbases",
    "get_new_block_blob",
    "submit_block",
    "submit_block_blob",
    "get_peers",
    "list_connected_peers",
]

[base_node.lmdb]
# Map headroom for the v6 JMT migration (#2593). The node grows the LMDB map only between write
# transactions: when the space left falls to resize_threshold_bytes it adds grow_size_bytes. At the
# upstream 64 MB threshold and 128 MB grow, dropping the legacy `jmt_node_data` table at the end of
# the migration failed with MDB_MAP_FULL on a mainnet chain, and only a crash-restart finished it.
# 2 GiB each keeps at least 2 GiB free before every write transaction. The map is address space, not
# disk: the node opens LMDB without MDB_WRITEMAP, so data.mdb grows only with what is written.
# The other lmdb keys keep upstream's defaults.
grow_size_bytes = 2_147_483_648
resize_threshold_bytes = 2_147_483_648

[base_node.p2p]
# Public address advertisement
# Note: <your_tari_onion_address_no_extension> is replaced during deployment
public_addresses = ["/onion3/<your_tari_onion_address_no_extension>:18189"]

# Concurrency limits for peer tasks
max_concurrent_inbound_tasks = 40
max_concurrent_outbound_tasks = 100

[base_node.p2p.transport]
# Every P2P dial goes through the stack's Tor SOCKS proxy (#2653). `socks5`, not `tor`: the `tor`
# transport needs a Tor control port to create its own hidden service, and the stack's control port
# is cookie-authenticated with the cookie private to the `tor` container. The onion Tari advertises
# (public_addresses above) is the stack Tor's hidden service, which forwards to the TCP listener
# below. There is no proxy bypass under `socks5`: onion and clearnet peer addresses alike are
# dialled through the proxy, so the node never opens a direct clearnet connection (#271).
type = "socks5"

[base_node.p2p.transport.tcp]
# Bind to all interfaces inside the container; the stack Tor's Tari hidden service forwards here.
listener_address = "/ip4/0.0.0.0/tcp/18189"

[base_node.p2p.transport.socks]
# The shared Tor container's SOCKS port, at its static IP 172.28.0.25
proxy_address = "/ip4/172.28.0.25/tcp/9050"

[base_node.state_machine]
# Synchronization timeouts
blockchain_sync_config.initial_max_sync_latency = 2000
blockchain_sync_config.rpc_deadline = 2000
